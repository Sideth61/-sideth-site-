<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Deth DSN</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@400;600;700&display=swap');
        
        body { 
            font-family: 'Kantumruy Pro', sans-serif; 
            background-color: #090d16; 
            color: #fff; 
            margin: 0; 
            padding: 20px; 
            padding-bottom: 100px;
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            min-height: 100vh;
        }
        .container { width: 100%; max-width: 450px; display: flex; flex-direction: column; gap: 20px; }
        .card { 
            background: rgba(17, 24, 39, 0.85); 
            padding: 20px; 
            border-radius: 20px; 
            border: 1px solid rgba(56, 189, 248, 0.3); 
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); 
        }
        .header-title { color: #38bdf8; font-size: 18px; margin-bottom: 15px; font-weight: bold; border-bottom: 1px solid rgba(56, 189, 248, 0.2); padding-bottom: 8px; }
        .setting-group { margin: 15px 0; }
        .setting-group label { display: block; color: #94a3b8; font-size: 13px; margin-bottom: 8px; font-weight: 600; }
        .options-row { display: flex; gap: 10px; }
        .option-btn { 
            flex: 1; 
            padding: 12px; 
            border-radius: 10px; 
            text-align: center; 
            cursor: pointer; 
            font-size: 13px; 
            font-weight: bold; 
            border: 1px solid #334155; 
            background: #1e293b;
            color: #fff;
            transition: 0.3s;
        }
        .option-btn.active { border-color: #38bdf8; background: #2563eb; color: #fff; }
        .back-btn { 
            display: block; 
            text-align: center; 
            background: #475569; 
            color: #fff; 
            padding: 14px; 
            border-radius: 12px; 
            text-decoration: none; 
            font-weight: bold; 
        }
        /* Dock ខាងក្រោម */
        .dsn-dock {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(17, 24, 39, 0.9);
            border: 1px solid rgba(56, 189, 248, 0.3);
            padding: 10px 20px;
            border-radius: 30px;
            display: flex;
            gap: 15px;
            z-index: 999;
        }
        .dock-item { font-size: 20px; text-decoration: none; padding: 5px; }
    </style>
</head>
<body>

    <div class="container">
        <div class="card">
            <div class="header-title">⚙️ ការកំណត់ប្រព័ន្ធ (Settings)</div>
            
            <div class="setting-group">
                <label>🌐 ភាសា (Language):</label>
                <div class="options-row">
                    <div class="option-btn active" id="langKm" onclick="switchLang('km')">🇰🇭 ខ្មែរ</div>
                    <div class="option-btn" id="langEn" onclick="switchLang('en')">🇬🇧 English</div>
                </div>
            </div>

            <div class="setting-group">
                <label>🎨 រចនាបទពណ៌ (Theme):</label>
                <div class="options-row">
                    <div class="option-btn active" id="themeDark" onclick="setTheme('dark')">Dark</div>
                    <div class="option-btn" id="themeOcean" onclick="setTheme('ocean')">Ocean</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="header-title">ℹ️ អំពីវេបសាយ</div>
            <p style="color: #cbd5e1; font-size: 13px; margin: 0;"><strong>ឈ្មោះ:</strong> Deth DSN<br><strong>ជំនាន់:</strong> 26.20.8</p>
        </div>

        <a href="index.html" class="back-btn">⬅️ ត្រឡប់ទៅទំព័រដើម</a>
    </div>

    <div class="dsn-dock">
        <a href="index.html" class="dock-item">🏠</a>
        <a href="library.html" class="dock-item">📚</a>
        <a href="setting.html" class="dock-item" style="filter: drop-shadow(0 0 5px #38bdf8);">⚙️</a>
    </div>

    <script>
        function switchLang(lang) {
            localStorage.setItem('dsn_lang', lang);
            document.getElementById('langKm').classList.toggle('active', lang === 'km');
            document.getElementById('langEn').classList.toggle('active', lang === 'en');
            alert('បានប្តូរភាសាជោគជ័យ!');
        }

        function setTheme(theme) {
            localStorage.setItem('dsn_theme', theme);
            document.getElementById('themeDark').classList.toggle('active', theme === 'dark');
            document.getElementById('themeOcean').classList.toggle('active', theme === 'ocean');
            alert('បានប្តូរ Theme ជោគជ័យ!');
        }
    </script>
</body>
</html>
